# Local development. Generate a unique key for any deployed environment.
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Configure either DATABASE_URL or the individual DB_* values below.
# DATABASE_URL=postgresql://jobboard_user:password@localhost:5432/jobboard
DB_NAME=jobboard
DB_USER=jobboard_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# In production (DEBUG=False), these default to secure values. Override only
# when your deployment topology requires it (for example, TLS termination).
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
